{
  "name": "taiko-private-hub",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router typegen && tsc --noEmit && react-router build",
    "build:cloudflare": "react-router typegen && tsc --noEmit && react-router build && node ./scripts/build-manifest.mjs",
    "deploy": "wrangler deploy",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@react-router/cloudflare": "^7.16.0",
    "@react-router/node": "^7.16.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "radix-ui": "^1.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.16.0",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260629.1",
    "@react-router/dev": "^7.16.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vercel/react-router": "1.3.6",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "wrangler": "^4.97.0"
