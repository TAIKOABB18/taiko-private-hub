# Nunca commits valores reales. En Docker/Render/Hetzner, inyectar por secrets.
PORT=8080
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=taiko-private-hub
S3_ACCESS_KEY_ID=REPLACE_ME
S3_SECRET_ACCESS_KEY=REPLACE_ME
UPLOAD_PART_SIZE_BYTES=104857600
UPLOAD_MAX_SIZE_BYTES=107374182400
UPLOAD_TTL_SECONDS=86400
# Sustituir por JWT/OIDC en producción; no usar este placeholder.
AUTH_MODE=external
