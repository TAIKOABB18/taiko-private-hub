{
  "name": "taiko-private-hub",
  "main": "./build/server/worker.js",
  "no_bundle": true,
  "compatibility_date": "2026-06-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ITEMS",
        "class_name": "ItemStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ItemStore"
      ]
    }
  ]
}
